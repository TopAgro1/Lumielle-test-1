{%- comment -%}
  Tarjeta de reseña. Uso: {% render 'lm-review', b: block, own: true, fuente: 'iHerb' %}
  own: reseña de un pedido de esta tienda. Si no, es de la fuente externa (se nombra siempre).
  Hasta 3 fotos de la persona (foto_1 a foto_3): chicas en la tarjeta, grandes al tocarlas.
{%- endcomment -%}
{%- assign r = b.settings -%}
<figure class="lm-card{% if own %} lm-card--own{% endif %}" {{ b.shopify_attributes }}>
  <div class="lm-card__top">{% render 'lm-stars', rating: r.estrellas, size: 14 %}<span>{{ r.fecha }}</span></div>
  {%- if r.titulo != blank -%}<span class="lm-card__title">{{ r.titulo }}</span>{%- endif -%}
  <blockquote>“{{ r.texto }}”</blockquote>
  {%- if r.foto_1 != blank or r.foto_2 != blank or r.foto_3 != blank -%}
  <div class="lm-card__pics" data-lm-pics>
    {%- for i in (1..3) -%}
      {%- assign fk = 'foto_' | append: i -%}{%- assign f = r[fk] -%}
      {%- if f != blank -%}
        {%- capture falt -%}Foto de {{ r.nombre | default: 'quien compró' }} con el producto{%- endcapture -%}
        <a class="lm-card__pic" href="{{ f | image_url: width: 1400 }}" target="_blank" rel="noopener" data-lm-pic>
          <img src="{{ f | image_url: width: 200, height: 200, crop: 'center' }}" alt="{{ f.alt | default: falt | escape }}" width="64" height="64" loading="lazy">
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- endif -%}
  <figcaption>
    <span class="lm-avatar" aria-hidden="true">{{ r.nombre | slice: 0 | upcase }}</span>
    <span class="lm-card__who">{{ r.nombre }}<small>{{ r.pais }}</small></span>
    <span class="lm-verified">{% render 'lm-icon', name: 'check' %}{% if own %}Compró en la tienda{% elsif fuente != blank %}En {{ fuente }}{% else %}Reseña externa{% endif %}</span>
  </figcaption>
</figure>
