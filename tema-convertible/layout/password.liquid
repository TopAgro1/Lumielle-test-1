<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">{%- endif -%}
    {% render 'tc-vars' %}
    {{ 'tc-base.css' | asset_url | stylesheet_tag }}
    {{ 'tc.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="lm tc template-password">
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
