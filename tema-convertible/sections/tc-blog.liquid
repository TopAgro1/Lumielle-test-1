{%- comment -%} Tema Convertible · Blog: lista de artículos. {%- endcomment -%}
<div class="lm tc">
<section class="lm-sec" style="padding-top:32px">
<div class="lm-wrap">
  <div class="lm-head"><h1 class="lm-h2">{{ blog.title }}</h1></div>
  {%- paginate blog.articles by 9 -%}
    <div class="tc-articles">
      {%- for article in blog.articles -%}
        <a class="tc-article-card" href="{{ article.url }}">
          <span class="tc-article-card__img">{%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{% render 'tc-img', slot: 'Foto del artículo', alt: '' %}{%- endif -%}</span>
          <span class="lm-small">{{ article.published_at | date: '%d/%m/%Y' }}</span>
          <h2>{{ article.title }}</h2>
          {%- if article.excerpt != blank -%}<span class="lm-lead">{{ article.excerpt | strip_html | truncate: 140 }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="tc-pager" aria-label="Páginas">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Página anterior">{% render 'lm-icon', name: 'left' %}</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Página siguiente">{% render 'lm-icon', name: 'right' %}</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>
</section>
</div>

{% schema %}
{
  "name": "TC · Blog",
  "tag": "div",
  "class": "tc-section",
  "settings": []
}
{% endschema %}
